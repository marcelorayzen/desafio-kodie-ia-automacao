              "id": "e2",
              "name": "priority",
              "value": "media",
              "type": "string"
            },
            {
              "id": "e3",
              "name": "department",
              "value": "atendimento",
              "type": "string"
            },
            {
              "id": "e4",
              "name": "sentiment",
              "value": "neutro",
              "type": "string"
            },
            {
              "id": "e5",
              "name": "summary",
              "value": "Falha ao classificar a mensagem.",
              "type": "string"
            },
            {
              "id": "e6",
              "name": "confidence",
              "value": 0,
              "type": "number"
            },
            {
              "id": "e7",
              "name": "needs_human_review",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "e8",
              "name": "review_reason",
              "value": "={{ 'Erro na API de classificação: ' + ($json.error?.message ?? 'desconhecido') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "name": "Preparar erro",
